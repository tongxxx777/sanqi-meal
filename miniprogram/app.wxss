/* 蜜桃奶油系 - 轻甜情侣风主题 */
@import './theme.wxss';

page {
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ---- 卡片 ---- */
.card {
  background: var(--card-bg);
  border-radius: 20rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-card);
}

/* ---- 按钮重置 ---- */
button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* 主按钮 */
.btn-primary {
  background: var(--gradient-primary);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: var(--shadow-button);
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

/* ---- FAB 悬浮按钮 ---- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  z-index: 999;
}

/* ---- 动画 ---- */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease-out;
}

/* ---- Slideview 滑动操作按钮（历史订单 标记/删除） ---- */
/* 轻量设计：透明壳 + 小号圆形图标钮 + 彩色文字标签，无大色块，更轻盈 */
/* 结构：.weui-slideview__btn__wrp（全高定位壳）> .weui-slideview__btn（视觉按钮）> text */

/* 按钮壳：透明背景，仅承担按钮间距（壳宽会被组件测量并参与滑动定位） */
.weui-slideview__btn__wrp.mark-btn,
.weui-slideview__btn__wrp.delete-btn {
  background-color: transparent !important;
  box-sizing: border-box;
  padding: 0 6rpx;
}

/* 视觉按钮：整体透明，图标圆钮与文字标签纵向居中 */
.weui-slideview__btn__wrp.mark-btn .weui-slideview__btn,
.weui-slideview__btn__wrp.delete-btn .weui-slideview__btn {
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  background: transparent !important;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.3;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

/* 文字标签配色（蜜桃橙 / 珊瑚红，呼应主题暖色系） */
.weui-slideview__btn__wrp.mark-btn .weui-slideview__btn { color: #E8930C; }
.weui-slideview__btn__wrp.delete-btn .weui-slideview__btn { color: #E57373; }

/* 圆形图标钮：浅色渐变小圆 + 细描边 + 轻投影，面积小巧不压迫 */
.weui-slideview__btn__wrp.mark-btn .weui-slideview__btn::before,
.weui-slideview__btn__wrp.delete-btn .weui-slideview__btn::before {
  display: block;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 74rpx;
  text-align: center;
  margin-bottom: 10rpx;
}

.weui-slideview__btn__wrp.mark-btn .weui-slideview__btn::before {
  content: '🔖';
  background: linear-gradient(160deg, #FFF7EC 0%, #FFE9C7 100%);
  border: 2rpx solid rgba(255, 159, 67, 0.35);
  box-shadow: 0 4rpx 12rpx rgba(255, 159, 67, 0.18);
}

.weui-slideview__btn__wrp.delete-btn .weui-slideview__btn::before {
  content: '🗑️';
  background: linear-gradient(160deg, #FFF1F0 0%, #FFDDDA 100%);
  border: 2rpx solid rgba(229, 115, 115, 0.35);
  box-shadow: 0 4rpx 12rpx rgba(229, 115, 115, 0.18);
}

/* 按压/悬停反馈（配合组件 hover-class，移动端触摸与桌面端点按表现一致） */
.weui-slideview__btn--hover {
  transform: scale(0.9);
  opacity: 0.75;
}

/* 禁用态：圆钮与标签置灰，保留布局占位（extClass 追加 btn-disabled 启用） */
.weui-slideview__btn__wrp.btn-disabled .weui-slideview__btn {
  color: #B0B0B8;
  opacity: 0.6;
}

.weui-slideview__btn__wrp.btn-disabled .weui-slideview__btn::before {
  background: #F0F0F3;
  border-color: #DDDDE3;
  box-shadow: none;
}


