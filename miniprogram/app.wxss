/* 蜜桃奶油系 - 轻甜情侣风主题 */
@import './theme.wxss';

page {
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  overflow-x: hidden;
}

/* ---- 卡片 ---- */
.card {
  background: var(--card-bg);
  border-radius: 20rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: var(--shadow-card);
}

/* ---- 按钮重置 ---- */
button {
  background: initial;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* 主按钮 */
.btn-primary {
  background: var(--gradient-primary);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: var(--shadow-button);
}

/* ---- 空状态 ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

/* ---- FAB 悬浮按钮 ---- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 200rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  z-index: 999;
}

/* ---- 动画 ---- */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fadeIn {
  animation: fadeIn 0.3s ease-out;
}

/* ---- Slideview 按钮 ---- */
.weui-slideview__btn__wrp.mark-btn {
  background-color: #FFB74D !important;
}

.weui-slideview__btn__wrp.mark-btn .weui-slideview__btn {
  background-color: #FFB74D !important;
}

.weui-slideview__btn__wrp.delete-btn {
  background-color: #E57373 !important;
}

.weui-slideview__btn__wrp.delete-btn .weui-slideview__btn {
  background-color: #E57373 !important;
}


