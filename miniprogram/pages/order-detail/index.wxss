/* 订单详情 - 蜜桃奶油系 */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background: var(--bg-color);
}

/* 头部卡片 - 温馨浪漫风 */
.header-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #FF7A9E 0%, #FFB3C7 55%, #FFD6E0 100%);
  border-radius: 32rpx;
  padding: 56rpx 36rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 122, 158, 0.25);
}

/* 柔和光晕装饰 */
.header-glow {
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.35) 0%, rgba(255,255,255,0) 70%);
  pointer-events: none;
}

.header-glow--tl {
  top: -80rpx;
  left: -60rpx;
}

.header-glow--br {
  bottom: -100rpx;
  right: -60rpx;
}

/* 散落小爱心/星光 */
.deco-heart {
  position: absolute;
  font-size: 30rpx;
  opacity: 0.85;
  pointer-events: none;
}

.deco-heart--1 {
  top: 44rpx;
  left: 40rpx;
}

.deco-heart--2 {
  top: 120rpx;
  right: 56rpx;
  font-size: 24rpx;
  opacity: 0.7;
}

/* 状态标签（右上角，半透明柔和） */
.status-tag {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  backdrop-filter: blur(4rpx);
}

.status-waiting {
  background: rgba(33, 150, 243, 0.92);
  color: white;
}

.status-pending {
  background: rgba(255, 152, 0, 0.92);
  color: white;
}

.status-completed {
  background: rgba(76, 175, 80, 0.92);
  color: white;
}

/* 主视觉：哪一餐（居中放大，温馨） */
.header-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-top: 8rpx;
}

.hero-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.35);
}

.hero-icon {
  font-size: 64rpx;
}

.hero-title {
  font-size: 50rpx;
  font-weight: 700;
  color: white;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(217, 68, 110, 0.25);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.hero-sub {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.hero-sub-line {
  width: 60rpx;
  height: 1rpx;
}

.hero-sub-line--l {
  background: linear-gradient(to left, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
}

.hero-sub-line--r {
  background: linear-gradient(to right, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0));
}

.hero-sub-text {
  margin: 0 22rpx;
  padding-left: 8rpx;
  font-size: 24rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.88);
  letter-spacing: 8rpx;
}

/* 点餐信息：温馨便签卡片 */
.info-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.3);
}

.info-item {
  display: flex;
  align-items: center;
}

.info-emoji {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.info-text {
  font-size: 27rpx;
  color: white;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.info-divider {
  width: 2rpx;
  height: 30rpx;
  background: rgba(255, 255, 255, 0.4);
  margin: 0 28rpx;
}

/* 区块 */
.section {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.dish-total {
  margin-left: auto;
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: normal;
}

/* 菜品列表 */
.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dish-item {
  display: flex;
  align-items: center;
  background: var(--bg-color);
  border-radius: 16rpx;
  padding: 16rpx;
}

.dish-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: var(--border-color);
}

.dish-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

/* 备注 */
.remark-card {
  background: #FFF5F2;
  border-radius: 16rpx;
  padding: 24rpx;
}

.remark-text {
  font-size: 28rpx;
  color: var(--primary-deep);
  line-height: 1.6;
}

/* 标记为已完成按钮 */
.complete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
  color: white;
  font-size: 34rpx;
  font-weight: 600;
  padding: 32rpx;
  border-radius: 50rpx;
  margin: 10rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
  position: relative;
  overflow: hidden;
  animation: pulse 2s ease-in-out infinite;
}

.complete-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

.complete-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
  animation: none;
}

/* 发送通知分享按钮 */
.share-btn {
  background: linear-gradient(135deg, #FFB347 0%, #FF8E53 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 179, 71, 0.5);
}

.share-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

.share-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 71, 0.5);
  animation: none;
}

/* 接单按钮（做菜人专用） */
.accept-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #43E97B 0%, #38F9D7 100%);
  color: white;
  font-size: 36rpx;
  font-weight: 700;
  padding: 36rpx;
  border-radius: 50rpx;
  margin: 10rpx 24rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(67, 233, 123, 0.45);
  position: relative;
  overflow: hidden;
  animation: pulse-green 1.8s ease-in-out infinite;
}

.accept-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
  animation: shimmer 2s infinite;
}

.accept-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(67, 233, 123, 0.45);
  animation: none;
}

@keyframes pulse-green {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

/* 成品照片 */
.photo-section .section-title { position: relative; }

.photo-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 2rpx dashed var(--primary-light);
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: var(--text-hint);
}

.photo-preview {
  display: flex;
  flex-direction: column;
}

.finished-photo {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  display: block;
}

.photo-actions {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-top: 24rpx;
}

.photo-action-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
}

.photo-action-btn .action-icon { margin-right: 8rpx; }

.photo-action-btn.delete {
  color: #E57373;
  background: #FFF5F5;
}

/* 点餐人查看照片提示 */
.photo-viewer-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  margin-top: 16rpx;
  background: #FFF5F2;
  border-radius: 12rpx;
}

.viewer-text {
  font-size: 26rpx;
  color: var(--primary-deep);
}

/* 点餐人等待上传照片 */
.photo-waiting {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  border: 2rpx dashed var(--border-color);
}

.waiting-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.waiting-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* 加载中 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 菜品展开 / 收起 */
.dish-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 14rpx 0;
  border-radius: 14rpx;
  background: var(--bg-color);
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.dish-toggle:active {
  filter: brightness(0.97);
}

.dish-toggle-arrow {
  width: 14rpx;
  height: 14rpx;
  margin-left: 10rpx;
  border-right: 3rpx solid var(--primary-color);
  border-bottom: 3rpx solid var(--primary-color);
  transform: translateY(-5rpx) rotate(45deg);
  transition: transform 0.25s ease;
}

.dish-toggle-arrow.up {
  transform: translateY(5rpx) rotate(-135deg);
}

/* 待接单面板 */
.waiting-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 40rpx 32rpx;
  margin-top: 8rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}

.waiting-ring {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--gradient-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card-light);
}

.waiting-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.waiting-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.waiting-sub {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.5;
}

/* 向下引导箭头 */
.scroll-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 18rpx;
}

.scroll-hint-line {
  width: 2rpx;
  height: 36rpx;
  background: linear-gradient(to bottom, var(--primary-light), rgba(255, 214, 224, 0));
}

.scroll-hint-arrow {
  width: 18rpx;
  height: 18rpx;
  border-right: 3rpx solid var(--primary-color);
  border-bottom: 3rpx solid var(--primary-color);
  transform: rotate(45deg);
  margin-top: -35rpx;
  border-bottom-right-radius: 2rpx;
  animation: scroll-bounce 1.6s ease-in-out infinite;
}

@keyframes scroll-bounce {
  0%, 100% {
    transform: translateY(0) rotate(45deg);
    opacity: 0.55;
  }
  50% {
    transform: translateY(8rpx) rotate(45deg);
    opacity: 1;
  }
}

/* 转发按钮图标 */
.share-btn .share-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

/* 转发按钮文字强制单行不折行 */
.share-btn {
  white-space: nowrap;
}

/* ========== 评价区（完成后：点餐人打分 + 大厨回复）========== */

/* 星级点选 */
.review-stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 12rpx 0 4rpx;
}

.review-star {
  font-size: 64rpx;
  line-height: 1.1;
  transition: transform 0.15s ease, opacity 0.15s ease, filter 0.15s ease;
}

.review-star.off {
  opacity: 0.3;
  filter: grayscale(1);
}

.review-star.on {
  animation: star-pop 0.25s ease;
}

.review-star:active {
  transform: scale(1.2);
}

@keyframes star-pop {
  0% { transform: scale(0.6); }
  60% { transform: scale(1.25); }
  100% { transform: scale(1); }
}

/* 星级文案（如"绝绝子！🤤"），未选时占位保持高度不跳动 */
.review-rating-label {
  min-height: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary-deep);
  margin-bottom: 20rpx;
}

/* 评价文字输入 */
.review-textarea {
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  padding: 22rpx 26rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--text-primary);
}

.review-textarea-ph {
  color: var(--text-hint);
  font-size: 26rpx;
}

/* 提交评价按钮：选了星才点亮渐变粉 */
.review-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 999rpx;
  background: #EEDDE3;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.review-submit.active {
  background: var(--gradient-primary);
  box-shadow: var(--shadow-button);
}

.review-submit.active:active {
  transform: scale(0.97);
}

.review-submit.disabled {
  opacity: 0.6;
}

/* 做菜人等待评价 */
.review-waiting {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx;
}

.review-waiting-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.review-waiting-text {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 评价卡片 */
.review-card {
  padding: 24rpx 26rpx;
  background: var(--selected-bg);
  border-radius: 20rpx;
  animation: review-in 0.3s ease;
}

@keyframes review-in {
  0% { opacity: 0; transform: translateY(10rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.review-card-head {
  display: flex;
  align-items: center;
}

.review-card-stars {
  display: flex;
  gap: 6rpx;
}

/* 星级文案：居中标语式，两侧粉色渐变细线（呼应头部 hero-sub 的装饰语言） */
.review-card-mood {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-card-mood-line {
  width: 56rpx;
  height: 1rpx;
}

.review-card-mood-line--l {
  background: linear-gradient(to left, rgba(255, 122, 158, 0.55), rgba(255, 122, 158, 0));
}

.review-card-mood-line--r {
  background: linear-gradient(to right, rgba(255, 122, 158, 0.55), rgba(255, 122, 158, 0));
}

.review-card-mood-text {
  margin: 0 20rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--primary-deep);
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.review-card-star {
  font-size: 32rpx;
  line-height: 1.1;
}

.review-card-star.off {
  opacity: 0.3;
  filter: grayscale(1);
}

.review-card-time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-hint);
}

.review-card-text {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  word-break: break-all;
  white-space: pre-wrap;
}

/* 大厨回复（白卡 + 左侧粉条，层级低于评价本体） */
.review-reply {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border-left: 6rpx solid var(--primary-dark);
  box-shadow: var(--shadow-card-light);
}

.review-reply-head {
  display: flex;
  align-items: center;
}

.review-reply-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.review-reply-name {
  font-size: 24rpx;
  color: var(--primary-deep);
  font-weight: 600;
}

.review-reply-time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-hint);
}

.review-reply-text {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: var(--text-primary);
  word-break: break-all;
  white-space: pre-wrap;
}

/* 回复输入条（嵌在评价卡片内，白底与卡片浅粉底区分） */
.review-reply-bar {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.review-reply-input {
  flex: 1;
  height: 68rpx;
  padding: 0 26rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: var(--text-primary);
  box-shadow: var(--shadow-card-light);
}

.review-reply-input-ph {
  color: var(--text-hint);
  font-size: 25rpx;
}

.review-reply-send {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #EEDDE3;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.review-reply-send.active {
  background: var(--gradient-primary);
  box-shadow: var(--shadow-button);
}

.review-reply-send.active:active {
  transform: scale(0.94);
}

.review-reply-send.disabled {
  opacity: 0.6;
}

.share-btn .share-text {
  white-space: nowrap;
  flex-shrink: 0;
}
