<view class="container" wx:if="{{order}}">
  <!-- 头部信息 -->
  <view class="header-card">
    <!-- 顶部装饰：柔和光晕 + 散落小爱心 -->
    <view class="header-glow header-glow--tl"></view>
    <view class="header-glow header-glow--br"></view>
    <text class="deco-heart deco-heart--1">💕</text>
    <text class="deco-heart deco-heart--2">✨</text>

    <!-- 状态标签（右上角） -->
    <view class="status-tag {{order.status === 'completed' ? 'status-completed' : order.status === 'waiting' ? 'status-waiting' : 'status-pending'}}">
      {{order.status === 'completed' ? '已完成' : order.status === 'waiting' ? '待接单' : '进行中'}}
    </view>

    <!-- 主视觉：哪一餐（居中放大，温馨突出） -->
    <view class="header-hero">
      <view class="hero-icon-wrap">
        <text class="hero-icon">🍽</text>
      </view>
      <text class="hero-title">{{order.expectText || '未设置用餐时间'}}</text>
      <view class="hero-sub">
        <view class="hero-sub-line hero-sub-line--l"></view>
        <text class="hero-sub-text">叁餐有你 柒待余生</text>
        <view class="hero-sub-line hero-sub-line--r"></view>
      </view>
    </view>

    <!-- 点餐信息：温馨便签卡片 -->
    <view class="info-note" wx:if="{{order.creatorName || order.dateText}}">
      <view class="info-item" wx:if="{{order.creatorName}}">
        <text class="info-emoji">💑</text>
        <text class="info-text">点餐人 · {{order.creatorName}}</text>
      </view>
      <view class="info-divider" wx:if="{{order.creatorName && order.dateText}}"></view>
      <view class="info-item" wx:if="{{order.dateText}}">
        <text class="info-emoji">🕗</text>
        <text class="info-text">点餐时间 · {{order.dateShortText}}</text>
      </view>
    </view>
  </view>

  <!-- 菜品列表 -->
  <view class="section">
    <view class="section-title">
      <text class="section-icon">📋</text>
      <text>菜品清单</text>
      <text class="dish-total">共{{order.dishes.length}}道</text>
    </view>
    <view class="dish-list">
      <view class="dish-item" wx:for="{{order.dishes}}" wx:key="_id" wx:if="{{dishesExpanded || index < 2}}">
        <image class="dish-image" src="{{item._localImg || item.imageUrl || '/images/default.jpg'}}" mode="aspectFill" lazy-load></image>
        <text class="dish-name">{{item.name}}</text>
      </view>
    </view>
    <view class="dish-toggle" wx:if="{{order.dishes.length > 2}}" bindtap="toggleDishes">
      <text>{{dishesExpanded ? '收起' : '点击显示更多'}}</text>
      <view class="dish-toggle-arrow {{dishesExpanded ? 'up' : ''}}"></view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section" wx:if="{{order.remark}}">
    <view class="section-title">
      <text class="section-icon">💬</text>
      <text>备注</text>
    </view>
      <view class="remark-card">
        <text class="remark-text">{{order.remark}}</text>
      </view>
  </view>

  <!-- 成品照片（仅进行中 / 已完成可见） -->
  <view class="section photo-section" wx:if="{{order.status !== 'waiting'}}">
    <view class="section-title">
      <text class="section-icon">📸</text>
      <text>成品照片</text>
    </view>

    <!-- 已有照片 -->
    <view class="photo-preview" wx:if="{{order.finishedPhoto}}">
      <image class="finished-photo" src="{{order.finishedPhoto}}" mode="aspectFill" bindtap="previewPhoto"></image>
      <!-- 做菜人才能操作照片 -->
      <view class="photo-actions" wx:if="{{isCook}}">
        <view class="photo-action-btn" bindtap="changePhoto">
          <text class="action-icon">🔄</text>
          <text>更换照片</text>
        </view>
        <view class="photo-action-btn delete" bindtap="deletePhoto">
          <text class="action-icon">🗑️</text>
          <text>删除</text>
        </view>
      </view>
    </view>

    <!-- 未上传照片：做菜人可上传 -->
    <view class="photo-upload" wx:if="{{!order.finishedPhoto && isCook}}" bindtap="uploadPhoto">
      <view class="upload-icon">📷</view>
      <text class="upload-text">拍一张做好的菜</text>
      <text class="upload-hint">点击上传照片</text>
    </view>

    <!-- 未上传照片：点餐人等待 -->
    <view class="photo-waiting" wx:if="{{!order.finishedPhoto && isCreator}}">
      <text class="waiting-icon">📸</text>
      <text class="waiting-text">等待大厨上传成品照片</text>
    </view>
  </view>

  <!-- 评价（订单完成后：点餐人打分，大厨可回复一次） -->
  <view class="section review-section" wx:if="{{order.status === 'completed'}}">
    <view class="section-title">
      <text class="section-icon">❤️</text>
      <text>评价这餐</text>
    </view>

    <!-- 点餐人：评价表单（未评价时） -->
    <view class="review-form" wx:if="{{isCreator && !order.review}}">
      <view class="review-stars">
        <text class="review-star {{ratingInput >= item ? 'on' : 'off'}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this" data-value="{{item}}" bindtap="onStarTap">⭐</text>
      </view>
      <view class="review-rating-label">{{ratingLabels[ratingInput]}}</view>
      <textarea class="review-textarea" value="{{reviewText}}" bindinput="onReviewTextInput" placeholder="{{reviewPlaceholders[ratingInput]}}" placeholder-class="review-textarea-ph" maxlength="200" cursor-spacing="24" adjust-position="{{true}}" show-confirm-bar="{{false}}" />
      <view class="review-submit {{ratingInput ? 'active' : ''}} {{reviewSending ? 'disabled' : ''}}" bindtap="submitReview">
        <text>{{reviewSending ? '提交中...' : '提交评价'}}</text>
      </view>
    </view>

    <!-- 做菜人：等待评价（未评价时） -->
    <view class="review-waiting" wx:if="{{isCook && !order.review}}">
      <text class="review-waiting-icon">⏳</text>
      <text class="review-waiting-text">等待 {{partnerName}} 评价这餐</text>
    </view>

    <!-- 评价卡片（双方可见） -->
    <view class="review-card" wx:if="{{order.reviewView}}">
      <view class="review-card-head">
        <view class="review-card-stars">
          <text class="review-card-star {{order.reviewView.rating >= item ? 'on' : 'off'}}" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this">⭐</text>
        </view>
        <text class="review-card-time">{{order.reviewView.timeText}}</text>
      </view>
      <text class="review-card-text" wx:if="{{order.reviewView.text}}">{{order.reviewView.text}}</text>

      <!-- 大厨回复（已回复） -->
      <view class="review-reply" wx:if="{{order.replyView}}">
        <view class="review-reply-head">
          <text class="review-reply-icon">💌</text>
          <text class="review-reply-name">大厨回复</text>
          <text class="review-reply-time">{{order.replyView.timeText}}</text>
        </view>
        <text class="review-reply-text">{{order.replyView.text}}</text>
      </view>

      <!-- 做菜人：回复输入（未回复时） -->
      <view class="review-reply-bar" wx:if="{{isCook && !order.reviewReply}}">
        <input class="review-reply-input" value="{{replyText}}" bindinput="onReplyInput" bindconfirm="submitReply" placeholder="回复一下 TA 的评价..." placeholder-class="review-reply-input-ph" maxlength="200" confirm-type="send" adjust-position="{{true}}" cursor-spacing="24" />
        <view class="review-reply-send {{replyText ? 'active' : ''}} {{replySending ? 'disabled' : ''}}" bindtap="submitReply">回复</view>
      </view>
    </view>
  </view>

  <!-- 底部操作区域 ========================================== -->

  <!-- 待接单 + 点餐人：等待 TA 接单 + 分享 -->
  <block wx:if="{{order.status === 'waiting' && isCreator}}">
    <view class="waiting-panel">
      <view class="waiting-ring">
        <text class="waiting-emoji">🍳</text>
      </view>
      <text class="waiting-title">等待 {{partnerName}} 接单</text>
      <text class="waiting-sub">TA 还没接单呢，快去把人"骗"进厨房~</text>
    </view>
    <view class="scroll-hint">
      <view class="scroll-hint-line"></view>
      <view class="scroll-hint-arrow"></view>
    </view>
    <button class="complete-btn share-btn" open-type="share">
      <text class="share-icon">💌</text>
      <text class="share-text">转发给 {{partnerName}}</text>
    </button>
  </block>

  <!-- 待接单 + 做菜人：接单按钮 -->
  <view class="accept-btn" wx:if="{{order.status === 'waiting' && isCook}}" bindtap="acceptOrder">
    <text>收到！这就去做饭😊</text>
  </view>

  <!-- 进行中 + 做菜人：确认完成按钮 -->
  <view class="complete-btn" wx:if="{{order.status === 'pending' && isCook}}" bindtap="markAsCompleted">
    <text>确认完成</text>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
<bind-guard />
