<view class="container" wx:if="{{order}}">
  <!-- 头部信息 -->
  <view class="header-card">
    <view class="header-row">
      <text class="header-date">{{order.dateText}}</text>
      <view class="status-tag {{order.status === 'completed' ? 'status-completed' : order.status === 'waiting' ? 'status-waiting' : 'status-pending'}}">
        {{order.status === 'completed' ? '已完成' : order.status === 'waiting' ? '待接单' : '进行中'}}
      </view>
    </view>
    <view class="header-creator">{{order.creatorName}}点的菜</view>
    <view class="header-expect" wx:if="{{order.expectText}}">🕗 期望用餐时间：{{order.expectText}}</view>
  </view>

  <!-- 菜品列表 -->
  <view class="section">
    <view class="section-title">
      <text class="section-icon">🍽️</text>
      <text>菜品清单</text>
      <text class="dish-total">共{{order.dishes.length}}道</text>
    </view>
    <view class="dish-list">
      <view class="dish-item" wx:for="{{order.dishes}}" wx:key="_id" wx:if="{{dishesExpanded || index < 1}}">
        <image class="dish-image" src="{{item.imageUrl || '/images/default.jpg'}}" mode="aspectFill" lazy-load></image>
        <text class="dish-name">{{item.name}}</text>
      </view>
    </view>
    <view class="dish-toggle" wx:if="{{order.dishes.length > 1}}" bindtap="toggleDishes">
      <text>{{dishesExpanded ? '收起' : '展开全部'}}</text>
      <view class="dish-toggle-arrow {{dishesExpanded ? 'up' : ''}}"></view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section" wx:if="{{order.remark}}">
    <view class="section-title">
      <text class="section-icon">💬</text>
      <text>备注</text>
    </view>
      <view class="remark-card">
        <text class="remark-text">{{order.remark}}</text>
      </view>
  </view>

  <!-- 成品照片（仅进行中 / 已完成可见） -->
  <view class="section photo-section" wx:if="{{order.status !== 'waiting'}}">
    <view class="section-title">
      <text class="section-icon">📸</text>
      <text>成品照片</text>
    </view>

    <!-- 已有照片 -->
    <view class="photo-preview" wx:if="{{order.finishedPhoto}}">
      <image class="finished-photo" src="{{order.finishedPhoto}}" mode="aspectFill" bindtap="previewPhoto"></image>
      <!-- 做菜人才能操作照片 -->
      <view class="photo-actions" wx:if="{{isCook}}">
        <view class="photo-action-btn" bindtap="changePhoto">
          <text class="action-icon">🔄</text>
          <text>更换照片</text>
        </view>
        <view class="photo-action-btn delete" bindtap="deletePhoto">
          <text class="action-icon">🗑️</text>
          <text>删除</text>
        </view>
      </view>
    </view>

    <!-- 未上传照片：做菜人可上传 -->
    <view class="photo-upload" wx:if="{{!order.finishedPhoto && isCook}}" bindtap="uploadPhoto">
      <view class="upload-icon">📷</view>
      <text class="upload-text">拍一张做好的菜</text>
      <text class="upload-hint">点击上传照片</text>
    </view>

    <!-- 未上传照片：点菜人等待 -->
    <view class="photo-waiting" wx:if="{{!order.finishedPhoto && isCreator}}">
      <text class="waiting-icon">⏳</text>
      <text class="waiting-text">等待大厨上传成品照片</text>
    </view>
  </view>

  <!-- 底部操作区域 ========================================== -->

  <!-- 待接单 + 点菜人：等待 TA 接单 + 分享 -->
  <block wx:if="{{order.status === 'waiting' && isCreator}}">
    <view class="waiting-panel">
      <view class="waiting-ring">
        <text class="waiting-emoji">⏳</text>
      </view>
      <text class="waiting-title">等待 {{partnerName}} 接单</text>
      <text class="waiting-sub">转发给 TA，一顿美味的大餐 由此开始咯~</text>
    </view>
    <view class="scroll-hint">
      <view class="scroll-hint-line"></view>
      <view class="scroll-hint-arrow"></view>
    </view>
    <button class="complete-btn share-btn" open-type="share">
      <text class="share-icon">💌</text>
      <text>转发给 {{partnerName}}</text>
    </button>
  </block>

  <!-- 待接单 + 做菜人：接单按钮 -->
  <view class="accept-btn" wx:if="{{order.status === 'waiting' && isCook}}" bindtap="acceptOrder">
    <text>收到！这就去做饭😊</text>
  </view>

  <!-- 进行中 + 做菜人：确认完成按钮 -->
  <view class="complete-btn" wx:if="{{order.status === 'pending' && isCook}}" bindtap="markAsCompleted">
    <text>确认完成</text>
  </view>

  <!-- 进行中 + 点菜人：等待完成 -->
  <view class="waiting-complete" wx:if="{{order.status === 'pending' && isCreator}}">
    <text class="waiting-icon">⏳</text>
    <text class="waiting-text">等待大厨完成...</text>
  </view>

  <!-- 已完成：状态提示 -->
  <view class="waiting-complete done-tip" wx:if="{{order.status === 'completed'}}">
    <text class="waiting-icon">✅</text>
    <text class="waiting-text">已完成，菜品已上桌 🎉</text>
  </view>
</view>

<!-- 加载中 -->
<view class="loading" wx:if="{{loading}}">
  <text>加载中...</text>
</view>
<bind-guard />
