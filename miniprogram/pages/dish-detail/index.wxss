/* 菜品详情页样式 - 蜜桃奶油系 · 杂志封面风 */

.container {
  padding: 24rpx 24rpx 60rpx;
  min-height: 100vh;
  background: var(--bg-color);
}

/* ---- 照片大卡：挑高填满首屏 ---- */
.photo-card {
  position: relative;
  height: 660rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(255, 122, 158, 0.22);
}

.photo {
  width: 100%;
  height: 100%;
  display: block;
}

/* 底部渐变压暗，承载白色字幕 */
.photo-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46%;
  background: linear-gradient(to top, rgba(60, 20, 35, 0.55) 0%, rgba(60, 20, 35, 0) 100%);
  pointer-events: none;
}

/* 菜名字幕：压在照片左下角，避开上浮卡重叠区与原图按钮 */
.photo-caption {
  position: absolute;
  left: 36rpx;
  right: 220rpx;
  bottom: 112rpx;
}

.photo-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 查看原图：半透白胶囊悬浮钮 */
.view-original {
  position: absolute;
  right: 32rpx;
  bottom: 112rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.18);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.vo-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.vo-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--primary-deep);
  letter-spacing: 1rpx;
}

.vo-hover {
  transform: scale(0.94);
  opacity: 0.8;
}

/* ---- 上浮信息卡：与照片卡重叠，制造层次 ---- */
.float-card {
  position: relative;
  margin: -64rpx 28rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow-card-medium);
}

/* 三格数据档案 */
.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-emoji {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  letter-spacing: 2rpx;
}

.stat-divider {
  width: 2rpx;
  height: 72rpx;
  background: var(--divider-color);
  flex-shrink: 0;
}

/* ---- 分类徽章：分隔线 + 浅粉胶囊 ---- */
.category-row {
  display: flex;
  margin-top: 28rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--divider-color);
}

.category-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #FFF0F3;
}

.category-badge-icon {
  font-size: 28rpx;
}

.category-badge-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--primary-deep);
  letter-spacing: 1rpx;
}

/* ---- 备注：杂志引用块 ---- */
.desc-box {
  position: relative;
  margin-top: 32rpx;
  background: #FFF5F2;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
}

/* 无描述空态：浅色引导文案 */
.desc-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #FAFAFA;
}

.desc-empty-icon {
  font-size: 28rpx;
}

.desc-empty-text {
  font-size: 26rpx;
  color: var(--text-hint);
  letter-spacing: 1rpx;
}

.desc-quote {
  position: absolute;
  top: 0;
  left: 16rpx;
  font-size: 56rpx;
  line-height: 1;
  color: var(--primary-dark);
}

.desc-text {
  display: block;
  padding-left: 46rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  word-break: break-all;
}

/* ---- 操作按钮：纵向两行，主编辑 + 次删除 ---- */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 48rpx;
}

.btn-edit,
.btn-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 30rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn-edit {
  background: var(--gradient-primary);
  color: #fff;
  box-shadow: var(--shadow-button);
}

/* 删除：弱化次按钮，白底浅红 + 淡边框 */
.btn-delete {
  background: #fff;
  color: #E57373;
  border: 2rpx solid #F3C5C5;
  box-sizing: border-box;
}

.btn-icon {
  font-size: 30rpx;
}

/* 按压反馈 */
.btn-hover {
  transform: scale(0.96);
  opacity: 0.85;
}
