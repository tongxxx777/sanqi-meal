<view class="container" wx:if="{{dish}}">
  <!-- 照片大卡：悬浮圆角 + 底部渐变字幕 -->
  <view class="photo-card">
    <image class="photo" src="{{dish._localImg || dish.imageUrl || previewImageUrl || '/images/default.jpg'}}" mode="aspectFill" bindtap="previewImage"></image>
    <view class="photo-mask"></view>
    <view class="photo-caption">
      <text class="photo-title">{{dish.name}}</text>
    </view>
    <!-- 查看原图：醒目的悬浮胶囊按钮 -->
    <view class="view-original" hover-class="vo-hover" hover-stay-time="80" bindtap="previewImage">
      <text class="vo-icon">🔍</text>
      <text class="vo-text">查看原图</text>
    </view>
  </view>

  <!-- 上浮信息卡：三格数据档案 -->
  <view class="float-card">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-emoji">💑</text>
        <text class="stat-value">{{creatorName || '未知'}}</text>
        <text class="stat-label">添加人</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-emoji">🕗</text>
        <text class="stat-value">{{dateMiniText || '--'}}</text>
        <text class="stat-label">加入菜单</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-emoji">🍽️</text>
        <text class="stat-value">{{dish.orderCount || 0}} 次</text>
        <text class="stat-label">被点次数</text>
      </view>
    </view>

    <!-- 分类徽章 -->
    <view class="category-row" wx:if="{{categoryInfo}}">
      <view class="category-badge">
        <text class="category-badge-icon">{{categoryInfo.icon}}</text>
        <text class="category-badge-name">{{categoryInfo.name}}</text>
      </view>
    </view>

    <!-- 备注：引用块样式；无描述时显示空态引导 -->
    <view class="desc-box" wx:if="{{dish.description}}">
      <text class="desc-quote">“</text>
      <text class="desc-text">{{dish.description}}</text>
    </view>
    <view class="desc-box desc-empty" wx:else>
      <text class="desc-empty-icon">✍️</text>
      <text class="desc-empty-text">还没有介绍，点下方「编辑菜品」补充一句吧~</text>
    </view>
  </view>

  <!-- 用料展示卡：仅有数据时渲染 -->
  <view class="recipe-card" wx:if="{{ingredientsView.length}}">
    <view class="recipe-title">
      <text class="recipe-title-emoji">🥚</text>
      <text class="recipe-title-text">用料</text>
    </view>
    <view class="ing-list">
      <view class="ing-row" wx:for="{{ingredientsView}}" wx:key="index">
        <text class="ing-name">{{item.name}}</text>
        <text class="ing-amount">{{item.amount}}</text>
      </view>
    </view>
  </view>

  <!-- 做法展示卡：仅有数据时渲染 -->
  <view class="recipe-card" wx:if="{{stepsView.length}}">
    <view class="recipe-title">
      <text class="recipe-title-emoji">🔥</text>
      <text class="recipe-title-text">做法</text>
    </view>
    <view class="cook-step" wx:for="{{stepsView}}" wx:key="index">
      <image wx:if="{{item._localImg}}" class="cook-step-img" src="{{item._localImg}}" mode="aspectFill"
             bindtap="previewStepImage" data-index="{{index}}"></image>
      <view class="cook-step-main">
        <view class="cook-step-badge">{{index + 1}}</view>
        <text class="cook-step-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮：纵向两行，主编辑 + 次删除 -->
  <view class="action-buttons">
    <view class="btn-edit" hover-class="btn-hover" hover-stay-time="80" bindtap="editDish">
      <text class="btn-icon">✏️</text>
      <text>编辑菜品</text>
    </view>
    <view class="btn-delete" hover-class="btn-hover" hover-stay-time="80" bindtap="deleteDish">
      <text class="btn-icon">🗑️</text>
      <text>删除菜品</text>
    </view>
  </view>
</view>
<bind-guard />
