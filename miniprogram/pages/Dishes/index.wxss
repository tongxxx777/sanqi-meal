/* ========================================
   菜品库样式 - 蜜桃奶油系配色 + 重构布局
   与点餐页同色系但结构独立区分
   ======================================== */

/* 页面级滚动：容器不再锁 100vh，由页面自身滚动，下拉刷新交给原生手势 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

/* 可滚动内容区：自带下拉刷新，排序时关闭 */
.content-scroll {
  flex: 1;
  height: 0;
}

/* ========== 页面头部（渐变背景，与点餐页一致） ========== */
.page-header {
  padding: 30rpx 24rpx 20rpx;
  background: var(--gradient-header);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 列数切换按钮 */
.header-grid-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  transition: transform 0.2s ease;
}

.header-grid-toggle:active {
  transform: scale(0.9);
}

.grid-icon {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
  width: 28rpx;
  height: 28rpx;
}

.grid-icon .gi-cell {
  background: #FFFFFF;
  border-radius: 3rpx;
}

/* 档位视觉微调：2列稍大图标、6列更紧凑 */
.grid-icon.cols-2 { grid-template-columns: 1fr 1fr; }
.grid-icon.cols-3 { grid-template-columns: 1fr 1fr 1fr; gap: 3rpx; width: 26rpx; height: 26rpx; }
.grid-icon.cols-3 .gi-cell:nth-child(4) { display: none; }
.grid-icon.cols-4 { grid-template-columns: 1fr 1fr; gap: 3rpx; }
.grid-icon.cols-6 { grid-template-columns: 1fr 1fr 1fr; gap: 2rpx; width: 24rpx; height: 24rpx; }
.grid-icon.cols-6 .gi-cell:nth-child(n+7) { display: none; }

.header-add {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.header-add-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  margin-right: 4rpx;
  font-weight: 300;
}

.header-add-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-top: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-hint);
  padding: 0 10rpx;
}

/* ========== 横向分类胶囊 ========== */
/* 吸顶：页面滚动时分类栏固定在顶部，观感与之前固定布局一致 */
.category-tabs {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--card-bg);
  white-space: nowrap;
  padding: 20rpx 0 12rpx;
}

.tabs-inner {
  display: flex;
  padding: 0 24rpx;
  gap: 16rpx;
}

.tab-pill {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: var(--highlight-bg);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.tab-pill.active {
  background: var(--gradient-primary);
  color: #FFFFFF;
  box-shadow: var(--shadow-button);
}

.tab-pill-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.tab-pill-name {
  font-size: 26rpx;
  font-weight: 500;
}

.tab-pill-count {
  font-size: 22rpx;
  min-width: 32rpx;
  text-align: center;
  margin-left: 8rpx;
  background: rgba(255, 122, 158, 0.15);
  color: var(--primary-color);
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
}

.tab-pill.active .tab-pill-count {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

/* ========== 菜品列表 ========== */
/* 普通文档流列表：底部多留空间，避免悬浮按钮遮住最后一行 */
.dish-list {
  padding-bottom: 140rpx;
}

/* 网格容器：各档 gap 在 cols-x 中定义 */
.dish-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

/* 菜品卡片 — 图片在上、文字在下 */
.dish-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card-light);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  /* border-box：排序态 2rpx 透明边框不额外占宽，保证排序前后每行数量一致 */
  box-sizing: border-box;
  /* 作为排序拖动图标的定位参照，否则绝对定位的 handle 会跑到页面右上角 */
  position: relative;
}

/* 列数档位：默认 2 列（大图 + 描述） */
.dish-grid.cols-2 {
  gap: 20rpx;
  padding-top: 20rpx;
}
.dish-grid.cols-2 .dish-card {
  width: calc((100% - 20rpx) / 2);
  margin-bottom: 24rpx;
}
.dish-grid.cols-2 .card-name { font-size: 28rpx; }
.dish-grid.cols-2 .card-desc { display: block; font-size: 22rpx; }

/* 3 列：均衡（图 + 菜名 + 描述） */
.dish-grid.cols-3 {
  gap: 16rpx;
  padding-top: 16rpx;
}
.dish-grid.cols-3 .dish-card {
  width: calc((100% - 32rpx) / 3);
  margin-bottom: 20rpx;
}
.dish-grid.cols-3 .card-name { font-size: 26rpx; }
.dish-grid.cols-3 .card-desc { display: block; font-size: 20rpx; }
.dish-grid.cols-3 .card-body { padding: 12rpx 12rpx 16rpx; }

/* 4 列：紧凑（仅菜名） */
.dish-grid.cols-4 {
  gap: 14rpx;
  padding-top: 14rpx;
}
.dish-grid.cols-4 .dish-card {
  width: calc((100% - 42rpx) / 4);
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}
.dish-grid.cols-4 .card-name { font-size: 24rpx; margin-bottom: 0; }
.dish-grid.cols-4 .card-desc { display: none; }
.dish-grid.cols-4 .card-body { padding: 10rpx 10rpx 14rpx; }

/* 6 列：图标墙（小图 + 小字菜名） */
.dish-grid.cols-6 {
  gap: 10rpx;
  padding-top: 10rpx;
}
.dish-grid.cols-6 .dish-card {
  width: calc((100% - 50rpx) / 6);
  margin-bottom: 12rpx;
  border-radius: 14rpx;
}
.dish-grid.cols-6 .card-name { font-size: 20rpx; margin-bottom: 0; }
.dish-grid.cols-6 .card-desc { display: none; }
.dish-grid.cols-6 .card-body { padding: 8rpx 6rpx 10rpx; }

.dish-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(255, 122, 158, 0.06);
}

/* 图片区 — 正方形，撑满卡片宽度 */
.card-image-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: var(--highlight-bg);
  overflow: hidden;
}

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.card-order-badge {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(255, 122, 158, 0.55));
  padding: 24rpx 10rpx 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  text-align: center;
}

/* 信息区 — 紧凑排列在图片下方 */
.card-body {
  padding: 16rpx 16rpx 20rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.card-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-bottom {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-hint);
  letter-spacing: 2rpx;
}

.list-empty {
  padding: 100rpx 0;
  text-align: center;
}

.list-empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* ========== 搜索无结果 ========== */
.search-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.search-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.search-empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.search-empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ========== 空状态（保持不变） ========== */
.empty-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-bottom: 40rpx;
}

.btn-primary {
  padding: 24rpx 60rpx;
  background: var(--gradient-primary);
  border-radius: 44rpx;
  font-size: 28rpx;
  color: white;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ========== 悬浮添加按钮 ========== */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(80rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  z-index: 999;
  transition: transform 0.2s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab-text {
  font-size: 52rpx;
  color: white;
  font-weight: 300;
  margin-top: -4rpx;
}

/* ========== 排序模式 ========== */

/* 工具行：排序入口。
   上方 = 分类胶囊下 padding(12rpx) + 本 margin-top(20rpx) = 32rpx，
   下方 = 本 margin-bottom(16rpx) + 网格 padding-top(16rpx) = 32rpx，上下对称；
   与 .sort-bar 占位完全一致（margin-top 20 + height 80 + margin-bottom 16），
   进入/退出排序时下方网格起始 Y 不变，菜品图片像素级重合 */
.tool-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 80rpx;
  margin: 20rpx 0 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.sort-entry {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  background: rgba(255, 122, 158, 0.1);
  border-radius: 28rpx;
  transition: transform 0.2s ease;
}

.sort-entry:active {
  transform: scale(0.95);
}

.sort-entry-icon {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-right: 10rpx;
}

.sort-entry-icon .se-line {
  width: 22rpx;
  height: 4rpx;
  background: var(--primary-color);
  border-radius: 2rpx;
}
.sort-entry-icon .se-line:nth-child(2) { width: 16rpx; }
.sort-entry-icon .se-line:nth-child(3) { width: 22rpx; }

.sort-entry-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* 排序提示条。占位与 .tool-row 完全一致（margin-top 20 + height 80 + margin-bottom 16），
   进入/退出排序时网格起始 Y 不变，菜品图片像素级重合 */
.sort-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  margin: 20rpx 0 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.sort-bar-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.sort-bar-actions {
  display: flex;
  gap: 16rpx;
}

.sort-btn-cancel {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.sort-btn-save {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--gradient-primary);
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: var(--shadow-button);
}

.sort-btn-save.saving {
  opacity: 0.6;
}

/* 排序容器：直接复用 .dish-grid.cols-x 的 flex 布局，与浏览完全一致 */
.dish-grid.sort-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 排序卡片：走普通 flex 流（与浏览卡片同款），仅叠加拖拽相关 */
.dish-card.sort-card {
  margin: 0;
  border: 2rpx solid transparent;
  /* 非拖拽卡片让位时平滑滑动，避免跳动 */
  transition: transform 0.18s ease;
}

/* 拖拽中的卡片：fixed 跟手（内联 left/top 控制）、无过渡、放大、阴影 */
.dish-card.sort-card.dragging {
  transition: none;
  position: fixed;
  z-index: 100;
  margin: 0;
  transform: scale(1.06);
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 158, 0.3), 0 0 0 2rpx var(--primary-color);
}

/* 移动图标徽标：抓手符号 ✥ */
.sort-handle {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  color: #FFFFFF;
  z-index: 5;
}

/* 排序模式下：所有外围功能置灰不可点 */
.category-tabs.sort-disabled,
.search-box.sort-disabled,
.header-actions.sort-disabled,
.fab.sort-disabled {
  opacity: 0.5;
  pointer-events: none;
}
