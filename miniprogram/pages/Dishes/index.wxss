/* ========================================
   菜品库样式 - 蜜桃奶油系配色 + 重构布局
   与点餐页同色系但结构独立区分
   ======================================== */

/* 页面级滚动：容器不再锁 100vh，由页面自身滚动，下拉刷新交给原生手势 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F5F5;
}

/* 可滚动内容区：自带下拉刷新，排序时关闭 */
.content-scroll {
  flex: 1;
  height: 0;
}

/* ========== 页面头部（渐变背景，与点餐页一致） ========== */
.page-header {
  padding: 30rpx 24rpx 20rpx;
  background: var(--gradient-header);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 列数切换按钮 */
.header-grid-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  transition: transform 0.2s ease;
}

.header-grid-toggle:active {
  transform: scale(0.9);
}

.grid-icon {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rpx;
  width: 28rpx;
  height: 28rpx;
}

.grid-icon .gi-cell {
  background: #FFFFFF;
  border-radius: 3rpx;
}

/* 档位视觉微调：2列稍大图标、6列更紧凑 */
.grid-icon.cols-2 { grid-template-columns: 1fr 1fr; }
.grid-icon.cols-3 { grid-template-columns: 1fr 1fr 1fr; gap: 3rpx; width: 26rpx; height: 26rpx; }
.grid-icon.cols-3 .gi-cell:nth-child(4) { display: none; }
.grid-icon.cols-4 { grid-template-columns: 1fr 1fr; gap: 3rpx; }
.grid-icon.cols-6 { grid-template-columns: 1fr 1fr 1fr; gap: 2rpx; width: 24rpx; height: 24rpx; }
.grid-icon.cols-6 .gi-cell:nth-child(n+7) { display: none; }

.header-add {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

.header-add-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  margin-right: 4rpx;
  font-weight: 300;
}

.header-add-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-top: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-hint);
  padding: 0 10rpx;
}

/* ========== 横向分类胶囊 ========== */
/* 吸顶：页面滚动时分类栏固定在顶部，观感与之前固定布局一致 */
/* 分类行：胶囊滚动区 + 右侧排序入口，整体粘性吸顶 */
.category-row {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  background: var(--card-bg);
  padding: 20rpx 24rpx 12rpx;
  box-sizing: border-box;
}

.category-tabs {
  flex: 1;
  min-width: 0;          /* 允许收缩，避免挤压右侧排序按钮 */
  white-space: nowrap;
}

.tabs-inner {
  display: flex;
  gap: 16rpx;
}

/* 排序入口：分类行右侧固定的渐变胶囊按钮，吸顶常显、一眼可见 */
.category-sort {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  margin-left: 16rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: var(--gradient-primary);
  box-shadow: var(--shadow-button);
  transition: transform 0.2s ease;
}

.category-sort:active {
  transform: scale(0.94);
}

.category-sort-icon {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-right: 6rpx;
  line-height: 1;
}

.category-sort-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.tab-pill {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 24rpx;
  background: var(--highlight-bg);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  transition: all 0.25s ease;
}

.tab-pill.active {
  background: var(--gradient-primary);
  color: #FFFFFF;
  box-shadow: var(--shadow-button);
}

.tab-pill-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

.tab-pill-name {
  font-size: 26rpx;
  font-weight: 500;
}

.tab-pill-count {
  font-size: 22rpx;
  min-width: 32rpx;
  text-align: center;
  margin-left: 8rpx;
  background: rgba(255, 122, 158, 0.15);
  color: var(--primary-color);
  border-radius: 20rpx;
  padding: 2rpx 10rpx;
}

.tab-pill.active .tab-pill-count {
  background: rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
}

/* ========== 菜品列表 ========== */
/* 普通文档流列表：底部多留空间，避免悬浮按钮遮住最后一行 */
.dish-list {
  padding-bottom: 140rpx;
}

/* 网格容器：各档 gap 在 cols-x 中定义 */
.dish-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

/* 菜品卡片 — 图片在上、文字在下 */
.dish-card {
  background: var(--card-bg);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card-light);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  /* border-box：排序态 2rpx 透明边框不额外占宽，保证排序前后每行数量一致 */
  box-sizing: border-box;
  /* 作为排序拖动图标的定位参照，否则绝对定位的 handle 会跑到页面右上角 */
  position: relative;
}

/* 列数档位：默认 2 列（大图 + 描述） */
.dish-grid.cols-2 {
  gap: 20rpx;
  padding-top: 20rpx;
}
.dish-grid.cols-2 .dish-card {
  width: calc((100% - 20rpx) / 2);
  margin-bottom: 24rpx;
}
.dish-grid.cols-2 .card-name { font-size: 28rpx; }
.dish-grid.cols-2 .card-desc { display: block; font-size: 22rpx; }

/* 3 列：均衡（图 + 菜名 + 描述） */
.dish-grid.cols-3 {
  gap: 16rpx;
  padding-top: 16rpx;
}
.dish-grid.cols-3 .dish-card {
  width: calc((100% - 32rpx) / 3);
  margin-bottom: 20rpx;
}
.dish-grid.cols-3 .card-name { font-size: 26rpx; }
.dish-grid.cols-3 .card-desc { display: block; font-size: 20rpx; }
.dish-grid.cols-3 .card-body { padding: 12rpx 12rpx 16rpx; }

/* 4 列：紧凑（仅菜名） */
.dish-grid.cols-4 {
  gap: 14rpx;
  padding-top: 14rpx;
}
.dish-grid.cols-4 .dish-card {
  width: calc((100% - 42rpx) / 4);
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}
.dish-grid.cols-4 .card-name { font-size: 24rpx; margin-bottom: 0; }
.dish-grid.cols-4 .card-desc { display: none; }
.dish-grid.cols-4 .card-body { padding: 10rpx 10rpx 14rpx; }

/* 6 列：图标墙（小图 + 小字菜名） */
.dish-grid.cols-6 {
  gap: 10rpx;
  padding-top: 10rpx;
}
.dish-grid.cols-6 .dish-card {
  width: calc((100% - 50rpx) / 6);
  margin-bottom: 12rpx;
  border-radius: 14rpx;
}
.dish-grid.cols-6 .card-name { font-size: 20rpx; margin-bottom: 0; }
.dish-grid.cols-6 .card-desc { display: none; }
.dish-grid.cols-6 .card-body { padding: 8rpx 6rpx 10rpx; }

.dish-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(255, 122, 158, 0.06);
}

/* 图片区 — 正方形，撑满卡片宽度 */
.card-image-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: var(--highlight-bg);
  overflow: hidden;
}

.card-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 点过次数角标：右上角悬浮式爱心胶囊，白底粉字，轻盈不遮图 */
.card-order-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  padding: 4rpx 14rpx 6rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 122, 158, 0.18);
}

.badge-heart {
  color: var(--primary-color);
  font-size: 18rpx;
  line-height: 1;
  margin-right: 4rpx;
}

.badge-count {
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.1;
}

/* 紧凑档位（4/6 列卡片小）：胶囊整体缩小一号 */
.dish-grid.cols-4 .card-order-badge,
.dish-grid.cols-6 .card-order-badge {
  top: 6rpx;
  right: 6rpx;
  padding: 2rpx 8rpx 4rpx;
}
.dish-grid.cols-4 .badge-heart,
.dish-grid.cols-6 .badge-heart { font-size: 14rpx; margin-right: 2rpx; }
.dish-grid.cols-4 .badge-count,
.dish-grid.cols-6 .badge-count { font-size: 16rpx; }

/* 信息区 — 紧凑排列在图片下方 */
.card-body {
  padding: 16rpx 16rpx 20rpx;
}

.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.card-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-bottom {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-hint);
  letter-spacing: 2rpx;
}

.list-empty {
  padding: 100rpx 0;
  text-align: center;
}

.list-empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

/* ========== 搜索无结果 ========== */
.search-empty {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.search-empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.search-empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.search-empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* ========== 空状态（保持不变） ========== */
.empty-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-hint);
  margin-bottom: 40rpx;
}

.btn-primary {
  padding: 24rpx 60rpx;
  background: var(--gradient-primary);
  border-radius: 44rpx;
  font-size: 28rpx;
  color: white;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* ========== 悬浮添加按钮 ========== */
/* 包裹层：sticky 吸底，使按钮随内容滚动，接近底部时吸在右下角 */
.fab-wrap {
  position: sticky;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: flex-end;
  padding-right: 36rpx;
  margin-top: 24rpx;
  height: 100rpx;
  pointer-events: none;   /* 包裹层不拦截，点击穿透到内部按钮 */
}

.fab {
  position: static;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-fab);
  pointer-events: auto;
  transition: transform 0.2s ease;
}

.fab:active {
  transform: scale(0.92);
}

.fab-text {
  font-size: 52rpx;
  color: white;
  font-weight: 300;
  margin-top: -4rpx;
}

/* ========== 排序模式 ========== */

/* 排序提示条：fixed 浮层吸顶，不占文档流。
   因此进入/退出排序时下方网格起始 Y 不变，菜品图片像素级重合 */
.sort-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
}

.sort-bar-tip {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.sort-bar-actions {
  display: flex;
  gap: 16rpx;
}

.sort-btn-cancel {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
  color: var(--text-secondary);
}

.sort-btn-save {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: var(--gradient-primary);
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
  box-shadow: var(--shadow-button);
}

.sort-btn-save.saving {
  opacity: 0.6;
}

/* 排序接管容器：显式高度（内联）+ 相对定位；卡片 absolute + translate 按实测坐标原位接管，像素级重合 */
.dish-grid.sort-ready {
  position: relative;
}

.dish-grid.sort-ready .dish-card {
  position: absolute;
  transition: none;
}

/* 换位补位动画：仅过渡 transform，GPU 合成，丝滑让位 */
.dish-grid.sort-anim .dish-card {
  transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* 进出排序的瞬时帧：禁掉一切过渡，防止 transform 插值导致卡片飞移 */
.dish-grid.no-trans .dish-card {
  transition: none !important;
}

/* 排序态禁用点按缩放反馈（兜底测量帧，避免 :active scale 污染测量） */
.dish-card.sort-card:active {
  transform: none;
}

/* 被拖卡片原位占位：半透明提示「这里空出来了」，位置随槽位补位动画 */
.dish-card.drag-src {
  opacity: 0.25;
}

/* 拖拽浮层：fixed 跟手 + 放大浮起，松手回弹落位 */
.drag-ghost {
  position: fixed;
  z-index: 200;
  background: var(--card-bg);
  border-radius: 20rpx;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 12rpx 30rpx rgba(255, 122, 158, 0.32), 0 0 0 2rpx var(--primary-color);
  transform: scale(1.06);
  pointer-events: none;
  will-change: left, top;
}

.drag-ghost.settling {
  transition: left 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
              top 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
              transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  transform: scale(1);
}

/* 浮层列数档位样式与网格内卡片保持一致 */
.drag-ghost.cols-3 .card-name { font-size: 26rpx; }
.drag-ghost.cols-3 .card-desc { font-size: 20rpx; }
.drag-ghost.cols-3 .card-body { padding: 12rpx 12rpx 16rpx; }
.drag-ghost.cols-4 { border-radius: 16rpx; }
.drag-ghost.cols-4 .card-name { font-size: 24rpx; margin-bottom: 0; }
.drag-ghost.cols-4 .card-desc { display: none; }
.drag-ghost.cols-4 .card-body { padding: 10rpx 10rpx 14rpx; }
.drag-ghost.cols-6 { border-radius: 14rpx; }
.drag-ghost.cols-6 .card-name { font-size: 20rpx; margin-bottom: 0; }
.drag-ghost.cols-6 .card-desc { display: none; }
.drag-ghost.cols-6 .card-body { padding: 8rpx 6rpx 10rpx; }

/* 移动图标徽标：抓手符号 ✥ */
.sort-handle {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  color: #FFFFFF;
  z-index: 5;
}

/* 排序模式下：所有外围功能置灰不可点 */
.category-row.sort-disabled,
.search-box.sort-disabled,
.header-actions.sort-disabled,
.fab.sort-disabled {
  opacity: 0.5;
  pointer-events: none;
}
